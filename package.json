{
  "name": "memory-lane",
  "version": "0.1.0",
  "private": true,
  "description": "Memory Lane — a private, algorithm-free memory album (MVP). React + Express + SQLite, bilingual EN/VI.",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:phone": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"vite --host\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "start:demo": "node server/start.js",
    "seed": "node server/seed.js",
    "setup:google": "node server/setup-google.js",
    "admin": "node server/admin.js",
    "clip-labels": "node scripts/clip-labels.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e/system.mjs"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/playpen-sans": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "mssql": "^12.7.14",
    "multer": "^2.4.0",
    "nsfwjs": "^4.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
