{
  "name": "memory-lane",
  "version": "0.1.0",
  "private": true,
  "description": "Memory Lane — a private, algorithm-free memory album (MVP). React + Express + SQLite, bilingual EN/VI.",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:phone": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"vite --host\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "start:demo": "node server/seed.js && node server/index.js",
    "seed": "node server/seed.js",
    "setup:google": "node server/setup-google.js",
    "admin": "node server/admin.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e/system.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/playpen-sans": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
