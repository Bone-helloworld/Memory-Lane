# Copy to .env and adjust. Every value has a sensible default, so .env is optional.

# Port of the Express API (Vite proxies /api here during `npm run dev`).
PORT=3001

# Folder holding the SQLite database and uploaded photos and videos.
# In production point this at a persistent volume (e.g. /data).
DATA_DIR=./data

# Enables the one-click "Try the demo" button. Turn it off for a real deployment.
ALLOW_DEMO=true

# How long a login lasts, in days.
SESSION_DAYS=30

# Largest photo and largest video accepted, in megabytes.
MAX_UPLOAD_MB=15
MAX_VIDEO_MB=100

# Total space for one account's photos and videos, in megabytes.
STORAGE_MB=2048

# How many days an invite link stays valid.
INVITE_DAYS=7

# Login and register attempts allowed per IP in each 15-minute window.
AUTH_RATE_LIMIT=20

# Contact form (/contact). Notes are stored in contact_messages and written to the server log.
# How many contact notes one IP may send in 15 minutes.
# CONTACT_RATE_LIMIT=8

# "Continue with Google" — create an OAuth client in Google Cloud Console (see docs/DEPLOY.md).
# Leave empty to keep the Google button visible but disabled.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# The address people use to reach the app (builds Google's redirect URI). Optional locally.
# PUBLIC_URL=https://memorylane.example.com

# production → Secure cookies + trust the hosting proxy's HTTPS headers.
# NODE_ENV=production

# --- Azure SQL (production). Leave all of these unset to keep SQLite in DATA_DIR. ---
# Use either the single connection string or the four parts. The connection string wins if both are set.
# AZURE_SQL_CONNECTION_STRING=Server=tcp:memorylane-sql-29823.database.windows.net,1433;Initial Catalog=memorylane-db;User ID=mladmin;Password=...;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;
# AZURE_SQL_SERVER=memorylane-sql-29823.database.windows.net
# AZURE_SQL_DATABASE=memorylane-db
# AZURE_SQL_USER=mladmin
# AZURE_SQL_PASSWORD=
# Set only for a local SQL Server container. Azure SQL must keep this false.
# AZURE_SQL_TRUST_SERVER_CERTIFICATE=false

# --- Azure Blob Storage (production). Leave unset to keep files in DATA_DIR/uploads. ---
# The container stays private. Files are served by the app after an access check.
# Use either the connection string or the account and key. The connection string wins if both are set.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=memorylanest2555;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT=memorylanest2555
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=media
