# Copy to .env and adjust. Every value has a sensible default, so .env is optional.

# Port of the Express API (Vite proxies /api here during `npm run dev`).
PORT=3001

# Folder holding the SQLite database and uploaded photos and videos.
# In production point this at a persistent volume (e.g. /data).
DATA_DIR=./data

# Enables the one-click "Try the demo" button. Turn it off for a real deployment.
ALLOW_DEMO=true

# How long a login lasts, in days.
SESSION_DAYS=30

# Largest photo and largest video accepted, in megabytes.
MAX_UPLOAD_MB=15
MAX_VIDEO_MB=100

# Total space for one account's photos and videos, in megabytes.
STORAGE_MB=2048

# How many days an invite link stays valid.
INVITE_DAYS=7

# Login and register attempts allowed per IP in each 15-minute window.
AUTH_RATE_LIMIT=20

# "Continue with Google" — create an OAuth client in Google Cloud Console (see docs/DEPLOY.md).
# Leave empty to keep the Google button visible but disabled.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# The address people use to reach the app (builds Google's redirect URI). Optional locally.
# PUBLIC_URL=https://memorylane.example.com

# production → Secure cookies + trust the hosting proxy's HTTPS headers.
# NODE_ENV=production
